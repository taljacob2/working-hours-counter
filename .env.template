# ─────────────────────────────────────────────────────────────
# Working Hours Counter — Environment Variables
# ─────────────────────────────────────────────────────────────
#
# Copy this file to `.env` and fill in your values:
#
#   cp .env.template .env
#
# Vite automatically loads `.env` during `npm run dev` and
# `npm run build`.  Variables must be prefixed with VITE_ or
# NEXT_PUBLIC_ to be exposed to the browser (both prefixes are
# configured in vite.config.js).
#
# When these variables are set the app skips the in-browser
# Config screen and locks the "Reconfigure" button so that
# credentials cannot be overwritten at runtime.
# ─────────────────────────────────────────────────────────────

# Your Supabase project URL (Project Settings → API → Project URL)
# Example: https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Your Supabase anonymous / public key (Project Settings → API → anon public)
# This key is safe to expose in the browser — access is controlled by Row
# Level Security (RLS) policies that require an authenticated session.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
